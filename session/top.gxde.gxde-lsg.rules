// GXDE 兼容层沉浸式登录会话：会话里没有 polkit 认证代理，无法弹出密码框。
// 已在显示管理器登录、且本来就能 sudo 的管理员，在本地活动会话中免密启动；
// 只放行会话脚本使用的这一条命令，其它参数仍走默认的管理员认证。
polkit.addRule(function (action, subject) {
    if (action.id !== "top.gxde.gxde-lsg" || !subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }
    var command = action.lookup("command_line");
    var session = /^\/opt\/apps\/top\.gxde\.gxde-lsg\/files\/gxde-lsg --immersive --wayland-display=wayland-[0-9]+$/;
    if (!command || !session.test(command)) {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.isInGroup("sudo") || subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
